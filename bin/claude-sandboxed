#!/bin/bash
set -e

# Isolated Claude Code environment configuration
export NVM_DIR="/home/<user>/agent/.nvm"
export CLAUDE_CONFIG_DIR="/home/<user>/agent/.claude-config"
export CLAUDE_LOCAL_STATE_DIR="/home/<user>/agent/.claude-state"

# Load nvm first (before setting NPM_CONFIG_PREFIX)
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"

# Set PATH to include our npm bin (where claude is installed)
export PATH="/home/<user>/agent/.npm/bin:$PATH"

cd /home/<user>/agent

# Run Claude Code inside srt sandbox
exec srt --settings /home/<user>/agent/.srt-settings.json "claude $*"
